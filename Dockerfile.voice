FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /service
RUN groupadd -g 10002 voice && useradd -u 10002 -g 10002 -m voice
RUN pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.34,<1' \
    'python-multipart>=0.0.20,<1' 'faster-whisper>=1.1,<2' 'piper-tts>=1.3,<2' && \
    mkdir -p /voice-models /voices && chown -R voice:voice /voice-models /service
COPY services/voice_service.py /service/voice_service.py
USER voice
EXPOSE 8780
CMD ["uvicorn", "voice_service:app", "--host", "0.0.0.0", "--port", "8780", "--workers", "1", "--proxy-headers", "false"]
