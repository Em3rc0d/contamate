# Copiar a .env y reemplazar por un secreto aleatorio (mínimo 32 caracteres).
CONTAMATE_API_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO_SEGURO_32_CHAR
CONTAMATE_MODEL=qwen3:1.7b
CONTAMATE_NUM_CTX=2048
CONTAMATE_KEEP_ALIVE=30s
CONTAMATE_LLM_TIMEOUT=180
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=2048
# Modelo STT que se descargará solo al activar --profile voice y hacer una transcripción.
VOICE_STT_MODEL=tiny

# CPU profile default; 8 GB RAM host recommendation, adjust before enabling larger models.
OLLAMA_MEMORY_LIMIT=4g
CONTAMATE_OLLAMA_BUDGET_GIB=4
